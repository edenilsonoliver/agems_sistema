# ==========================================
# 🚀 AGEMS - Configurações de Produção
# ==========================================

# Segurança Django
DEBUG=False
SECRET_KEY=sua_chave_secreta_e_longa_aqui_gerada_aleatoriamente
ALLOWED_HOSTS=seusite.com.br,www.seusite.com.br

# Banco de Dados (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=agems_db
DB_USER=agems_user
DB_PASSWORD=uma_senha_muito_forte_aqui
DB_HOST=db
DB_PORT=5432

# URL completa para o dj-database-url:
DATABASE_URL=postgres://agems_user:uma_senha_muito_forte_aqui@db:5432/agems_db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Nginx / SSL
DOMAIN=seusite.com.br
EMAIL_LETSENCRYPT=admin@seusite.com.br
