# Definir comportamento padrão para lidar com quebras de linha
* text=auto

# Garantir que scripts shell sempre usem LF (Linux), mesmo no Windows
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Garantir que arquivos de configuração usem LF
.env* text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
requirements.txt text eol=lf

# Arquivos que devem manter CRLF se necessário (raro em sistemas web)
# *.bat text eol=crlf
# *.ps1 text eol=crlf

# Arquivos binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pptx binary
*.sqlite3 binary
