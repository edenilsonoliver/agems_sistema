{% extends 'base_modern.html' %}

{% block content %}
<div class="page-header">
    <h1 class="page-title">
        <i class="bi bi-gear me-2"></i>Configurações do Sistema
    </h1>
    <p class="page-subtitle">Gerencie tipos, usuários e configurações gerais</p>
</div>

<div class="row g-3">

    <!-- Usuários -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
                <h6 class="mb-0"><i class="bi bi-people me-2"></i>Usuários</h6>
                {% if user.pode_criar_usuario %}
                <a href="{% url 'usuario_create' %}" class="btn btn-sm btn-light py-0 px-2">
                    <i class="bi bi-plus-circle"></i>
                </a>
                {% endif %}
            </div>
            <div class="card-body py-3">
                <p class="text-muted small mb-3">Contas de acesso e permissões do sistema.</p>
                <a href="{% url 'usuario_list' %}" class="btn btn-outline-dark btn-sm w-100 mb-3">
                    <i class="bi bi-list-ul me-1"></i>Gerenciar Usuários
                </a>
                <div class="row text-center">
                    <div class="col-6 border-end">
                        <div class="text-muted small">Total</div>
                        <div class="h5 mb-0">{{total_usuarios|default:0}}</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Ativos</div>
                        <div class="h5 mb-0 text-success">{{usuarios_ativos|default:0}}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Diretorias -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                <h6 class="mb-0"><i class="bi bi-building me-2"></i>Diretorias</h6>
                <a href="{% url 'diretoria_create' %}" class="btn btn-sm btn-light py-0 px-2">
                    <i class="bi bi-plus-circle"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush" style="max-height: 180px; overflow-y: auto;">
                    {% for dir in diretorias %}
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                        <span class="small"><strong>{{dir.sigla}}</strong> — {{dir.nome}}</span>
                        <a href="{% url 'diretoria_edit' dir.pk %}" class="btn btn-outline-primary btn-sm py-0 px-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                    {% empty %}
                    <div class="text-muted text-center py-3 small">Nenhuma cadastrada</div>
                    {% endfor %}
                </div>
                <div class="p-2 border-top text-center">
                    <a href="{% url 'diretoria_list' %}" class="btn btn-outline-primary btn-sm">Ver Todas</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Subunidades -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header text-white d-flex justify-content-between align-items-center py-2"
                style="background-color: #4B0082;">
                <h6 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>Subunidades</h6>
                <a href="{% url 'subunidade_create' %}" class="btn btn-sm btn-light py-0 px-2">
                    <i class="bi bi-plus-circle"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush" style="max-height: 180px; overflow-y: auto;">
                    {% for sub in subunidades %}
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                        <div>
                            <span class="small fw-semibold">{{sub.nome}}</span>
                            <span
                                class="badge bg-secondary-subtle text-secondary ms-1 small">{{sub.diretoria.sigla}}</span>
                        </div>
                        <a href="{% url 'subunidade_edit' sub.pk %}" class="btn btn-outline-secondary btn-sm py-0 px-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                    {% empty %}
                    <div class="text-muted text-center py-3 small">Nenhuma cadastrada</div>
                    {% endfor %}
                </div>
                <div class="p-2 border-top text-center">
                    <a href="{% url 'subunidade_list' %}" class="btn btn-outline-secondary btn-sm">Ver Todas</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tipos de Entidade -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center py-2">
                <h6 class="mb-0"><i class="bi bi-tag me-2"></i>Tipos de Entidade</h6>
                <a href="{% url 'tipoentidade_create' %}" class="btn btn-sm btn-light py-0 px-2">
                    <i class="bi bi-plus-circle"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush" style="max-height: 180px; overflow-y: auto;">
                    {% for tipo in tipos_entidade %}
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                        <span class="small">{{tipo.nome}}</span>
                        <a href="{% url 'tipoentidade_edit' tipo.pk %}" class="btn btn-outline-info btn-sm py-0 px-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                    {% empty %}
                    <div class="text-muted text-center py-3 small">Nenhum cadastrado</div>
                    {% endfor %}
                </div>
                <div class="p-2 border-top text-center">
                    <a href="{% url 'tipoentidade_list' %}" class="btn btn-outline-info btn-sm">Ver Todos</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tipos de Serviço -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center py-2">
                <h6 class="mb-0"><i class="bi bi-wrench me-2"></i>Tipos de Serviço</h6>
                <a href="{% url 'tiposervico_create' %}" class="btn btn-sm btn-light py-0 px-2">
                    <i class="bi bi-plus-circle"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush" style="max-height: 180px; overflow-y: auto;">
                    {% for tipo in tipos_servico %}
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                        <span class="small">{{tipo.nome}}</span>
                        <a href="{% url 'tiposervico_edit' tipo.pk %}"
                            class="btn btn-outline-secondary btn-sm py-0 px-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                    {% empty %}
                    <div class="text-muted text-center py-3 small">Nenhum cadastrado</div>
                    {% endfor %}
                </div>
                <div class="p-2 border-top text-center">
                    <a href="{% url 'tiposervico_list' %}" class="btn btn-outline-secondary btn-sm">Ver Todos</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tipos de Instrumento -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-2">
                <h6 class="mb-0"><i class="bi bi-file-earmark me-2"></i>Tipos de Instrumento</h6>
                <a href="{% url 'tipoinstrumento_create' %}" class="btn btn-sm btn-light py-0 px-2">
                    <i class="bi bi-plus-circle"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush" style="max-height: 180px; overflow-y: auto;">
                    {% for tipo in tipos_instrumento %}
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                        <span class="small">{{tipo.nome}}</span>
                        <a href="{% url 'tipoinstrumento_edit' tipo.pk %}"
                            class="btn btn-outline-success btn-sm py-0 px-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                    {% empty %}
                    <div class="text-muted text-center py-3 small">Nenhum cadastrado</div>
                    {% endfor %}
                </div>
                <div class="p-2 border-top text-center">
                    <a href="{% url 'tipoinstrumento_list' %}" class="btn btn-outline-success btn-sm">Ver Todos</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tipos de Obrigação -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center py-2">
                <h6 class="mb-0"><i class="bi bi-list-check me-2"></i>Tipos de Obrigação</h6>
                <a href="{% url 'tipoobrigacao_create' %}" class="btn btn-sm btn-dark py-0 px-2">
                    <i class="bi bi-plus-circle"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush" style="max-height: 180px; overflow-y: auto;">
                    {% for tipo in tipos_obrigacao %}
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                        <span class="small">{{tipo.nome}}</span>
                        <a href="{% url 'tipoobrigacao_edit' tipo.pk %}"
                            class="btn btn-outline-warning btn-sm py-0 px-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                    {% empty %}
                    <div class="text-muted text-center py-3 small">Nenhum cadastrado</div>
                    {% endfor %}
                </div>
                <div class="p-2 border-top text-center">
                    <a href="{% url 'tipoobrigacao_list' %}" class="btn btn-outline-warning btn-sm">Ver Todos</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tipos de Ação -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center py-2">
                <h6 class="mb-0"><i class="bi bi-lightning me-2"></i>Tipos de Ação</h6>
                <a href="{% url 'tipoacao_create' %}" class="btn btn-sm btn-light py-0 px-2">
                    <i class="bi bi-plus-circle"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush" style="max-height: 180px; overflow-y: auto;">
                    {% for tipo in tipos_acao %}
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                        <span class="small">{{tipo.nome}}</span>
                        <a href="{% url 'tipoacao_edit' tipo.pk %}" class="btn btn-outline-danger btn-sm py-0 px-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                    {% empty %}
                    <div class="text-muted text-center py-3 small">Nenhum cadastrado</div>
                    {% endfor %}
                </div>
                <div class="p-2 border-top text-center">
                    <a href="{% url 'tipoacao_list' %}" class="btn btn-outline-danger btn-sm">Ver Todos</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Templates -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header text-white d-flex justify-content-between align-items-center py-2"
                style="background-color: #1a1a2e;">
                <h6 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Templates</h6>
                <a href="{% url 'template_create' %}" class="btn btn-sm btn-light py-0 px-2">
                    <i class="bi bi-plus-circle"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush" style="max-height: 180px; overflow-y: auto;">
                    {% for temp in conformidade_templates %}
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                        <div>
                            <span class="small fw-semibold">{{temp.nome}}</span>
                            <span class="badge bg-light text-secondary ms-1">{{temp.itens.count}} itens</span>
                        </div>
                        <a href="{% url 'template_edit' temp.pk %}" class="btn btn-outline-dark btn-sm py-0 px-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                    {% empty %}
                    <div class="text-muted text-center py-3 small">Nenhum template cadastrado</div>
                    {% endfor %}
                </div>
                <div class="p-2 border-top text-center">
                    <a href="{% url 'template_list' %}" class="btn btn-outline-dark btn-sm">Ver Todos</a>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}