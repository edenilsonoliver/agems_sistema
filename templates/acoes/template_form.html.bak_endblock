{% extends 'base_modern.html' %}

{% block content %}
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="{% url 'configuracoes' %}">Configurações</a></li>
                <li class="breadcrumb-item active">{% if template %}Editar{% else %}Criar{% endif %} Template</li>
            </ol>
        </nav>
        <h1 class="page-title mb-0"><i class="bi bi-file-earmark-text me-2"></i>{% if template %}Editar{% else %}Criar{%
            endif %} Template de Conformidade</h1>
    </div>
    {% if template %}
    <button type="button" class="btn btn-danger" onclick="excluirTemplate({{ template.id }})">
        <i class="bi bi-trash3 me-2"></i>Excluir Template
    </button>
    {% endif %}
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="card-title mb-0"><i class="bi bi-card-text me-2 text-primary"></i>Dados do Template</h5>
    </div>
    <div class="card-body">
        <form method="post" id="form-dados-template">
            {% csrf_token %}
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Nome do Template <span class="text-danger">*</span></label>
                    <input type="text" name="nome" class="form-control" value="{{ template.nome|default:'' }}" required
                        placeholder="Ex: Inspeção Elétrica">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Descrição</label>
                    <input type="text" name="descricao" class="form-control" value="{{ template.descricao|default:'' }}"
                        placeholder="Opcional — descreva brevemente o propósito deste template">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-save me-2"></i>Salvar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0"><i class="bi bi-list-check me-2 text-primary"></i>Itens de Verificação</h5>
        {% if template %}
        <span class="badge bg-primary-subtle text-primary fs-6" id="items-counter">{{ template.itens.count }} iten{{
            template.itens.count|pluralize:"s" }}</span>
        {% endif %}
    </div>
    <div class="card-body">
        {% if template %}
        <div class="input-group mb-4">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-plus-lg text-primary"></i></span>
            <input type="text" id="novo-item-nome" class="form-control border-start-0 py-2"
                placeholder="Digite o item e pressione Enter ou clique em Adicionar...">
            <button class="btn btn-primary px-4" type="button" onclick="addItem()">Adicionar</button>
        </div>

        <div id="items-list" class="list-group list-group-flush border rounded overflow-hidden">
            {% for item in template.itens.all %}
            <div class="list-group-item d-flex align-items-center p-3 gap-3 item-row" data-id="{{ item.id }}">
                <i class="bi bi-grip-vertical text-muted fs-5" style="cursor: grab;"></i>
                <input type="text" class="form-control form-control-sm border-0 bg-transparent flex-grow-1 p-0"
                    value="{{ item.nome }}" onblur="renameItem({{ item.id }}, this.value)"
                    onkeypress="if(event.key==='Enter') this.blur()" style="box-shadow: none; font-size: 0.95rem;">
                <button type="button" class="btn btn-link link-danger p-0 ms-auto flex-shrink-0"
                    onclick="removeItem({{ item.id }}, this)">
                    <i class="bi bi-trash fs-5"></i>
                </button>
            </div>
            {% empty %}
            <div class="p-5 text-center text-muted" id="empty-msg">
                <i class="bi bi-list-check fs-1 d-block mb-3 opacity-25"></i>
                Nenhum item adicionado a este template ainda.
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="alert alert-info border-0">
            <i class="bi bi-info-circle me-2"></i><strong>Atenção:</strong> Salve os dados básicos primeiro para poder
            adicionar itens de verificação.
        </div>
        {% endif %}
    </div>
</div>

<!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;" id="toastContainer"></div>

<style>
    .item-row {
        transition: background-color 0.15s;
        border-left: 3px solid transparent !important;
    }

    .item-row:hover {
        background-color: #f0f6ff;
        border-left-color: var(--primary-color, #0d6efd) !important;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
    const templateId = "{{ template.id|default:'' }}";
    const csrfToken = "{{ csrf_token }}";

    function showToast(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        const icons = { success: 'bi-check-circle-fill', danger: 'bi-x-octagon-fill', warning: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' };
        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white bg-${type} border-0 shadow-lg`;
        toast.setAttribute('role', 'alert');
        toast.innerHTML = `<div class="d-flex"><div class="toast-body d-flex align-items-center gap-2"><i class="bi ${icons[type] || icons.info} fs-5"></i><span>${message}</span></div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
        container.appendChild(toast);
        const bsToast = new bootstrap.Toast(toast, { delay: 4000 });
        bsToast.show();
        toast.addEventListener('hidden.bs.toast', () => toast.remove());
    }

    function updateCounter(delta) {
        const el = document.getElementById('items-counter');
        if (!el) return;
        const n = parseInt(el.dataset.n || el.textContent) + delta;
        el.dataset.n = n;
        el.textContent = `${n} item${n !== 1 ? 's' : ''}`;
    }

    if (templateId) {
        new Sortable(document.getElementById('items-list'), {
            animation: 150,
            handle: '.bi-grip-vertical',
        });
        document.getElementById('novo-item-nome').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); addItem(); }
        });
    }

    function addItem() {
        const input = document.getElementById('novo-item-nome');
        const nome = input.value.trim();
        if (!nome) return;

        const formData = new FormData();
        formData.append('template_id', templateId);
        formData.append('nome', nome);

        fetch('{% url "template_add_item_ajax" %}', {
            method: 'POST', body: formData, headers: { 'X-CSRFToken': csrfToken }
        }).then(r => r.json()).then(d => {
            if (d.status === 'success') {
                const empty = document.getElementById('empty-msg');
                if (empty) empty.remove();

                const list = document.getElementById('items-list');
                const div = document.createElement('div');
                div.className = 'list-group-item d-flex align-items-center p-3 gap-3 item-row';
                div.dataset.id = d.id;
                div.innerHTML = `
                    <i class="bi bi-grip-vertical text-muted fs-5" style="cursor: grab;"></i>
                    <input type="text" class="form-control form-control-sm border-0 bg-transparent flex-grow-1 p-0"
                           value="${d.nome}" onblur="renameItem(${d.id}, this.value)"
                           onkeypress="if(event.key==='Enter') this.blur()" style="box-shadow: none; font-size: 0.95rem;">
                    <button type="button" class="btn btn-link link-danger p-0 ms-auto flex-shrink-0" onclick="removeItem(${d.id}, this)">
                        <i class="bi bi-trash fs-5"></i>
                    </button>`;
                list.appendChild(div);
                input.value = '';
                input.focus();
                updateCounter(1);
                showToast('Item adicionado!');
            } else {
                showToast('Erro ao adicionar: ' + d.message, 'danger');
            }
        }).catch(err => showToast('Falha na requisição: ' + err, 'danger'));
    }

    function removeItem(id, btn) {
        btn.disabled = true;
        const formData = new FormData();
        formData.append('item_id', id);
        fetch('{% url "template_remove_item_ajax" %}', {
            method: 'POST', body: formData, headers: { 'X-CSRFToken': csrfToken }
        }).then(r => r.json()).then(d => {
            if (d.status === 'success') {
                document.querySelector(`.item-row[data-id="${id}"]`)?.remove();
                updateCounter(-1);
                showToast('Item removido.', 'warning');
            } else {
                btn.disabled = false;
                showToast('Erro ao remover: ' + d.message, 'danger');
            }
        }).catch(() => { btn.disabled = false; showToast('Falha na requisição.', 'danger'); });
    }

    function renameItem(id, novo) {
        if (!novo) return;
        const formData = new FormData();
        formData.append('item_id', id);
        formData.append('nome', novo);
        fetch('{% url "template_rename_item_ajax" %}', {
            method: 'POST', body: formData, headers: { 'X-CSRFToken': csrfToken }
        });
    }

    function excluirTemplate(id) {
        const modal = new bootstrap.Modal(document.getElementById('modal-confirmar-exclusao'));
        modal.show();
        document.getElementById('btn-confirmar-exclusao').onclick = function () {
            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Excluindo...';
            fetch(`/acoes/conformidades/template/${id}/delete/`, {
                method: 'POST', headers: { 'X-CSRFToken': csrfToken }
            }).then(r => r.json()).then(d => {
                if (d.status === 'success') {
                    window.location.href = "{% url 'configuracoes' %}";
                } else {
                    modal.hide();
                    showToast('Erro ao excluir: ' + d.message, 'danger');
                }
            }).catch(() => { modal.hide(); showToast('Falha na requisição.', 'danger'); });
        };
    }
</script>

<!-- MODAL de confirmação de exclusão -->
<div class="modal fade" id="modal-confirmar-exclusao" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Excluir Template</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-0">Esta ação <strong>não pode ser desfeita</strong>.<br>Deseja excluir este template
                    permanentemente?</p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-3">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger px-4" id="btn-confirmar-exclusao">
                    <i class="bi bi-trash3 me-1"></i>Excluir
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}