{% extends 'components/list_view.html' %}

{% block header_actions %}
<a href="{% url 'acao_calendario' %}" class="btn btn-outline-primary me-2"><i class="bi bi-calendar3"></i> Ver
    Calendário</a>
<a href="{% url 'acao_kanban' %}" class="btn btn-outline-success me-2"><i class="bi bi-kanban"></i> Ver Kanban</a>
<!-- Botão que abre o modal de seleção de tipo (sobrepõe o botão padrão do template base com JS) -->
{% endblock %}

{% block extra_filters %}
<div class="col-md-3">
    <select name="instrumento" id="instrumento" class="form-select" style="height: 40px;">
        <option value=""> Filtrar por Instrumento...</option>
        {% for inst in instrumentos %}
        <option value="{{inst.id}}" {% if instrumento_selecionado==inst.id %}selected{% endif %}>{{inst}}</option>
        {% endfor %}
    </select>
</div>
<div class="col-md-3">
    <select name="obrigacao" id="obrigacao" class="form-select" style="height: 40px;">
        <option value=""> Filtrar por Obrigação...</option>
        {% for obrigacao in obrigacoes %}
        <option value="{{obrigacao.id}}" {% if obrigacao_selecionada==obrigacao.id %}selected{% endif %}>
            {{obrigacao.titulo}}</option>
        {% endfor %}
    </select>
</div>
<div class="col-md-3">
    <select name="tipo_acao" id="tipo_acao" class="form-select" style="height: 40px;">
        <option value=""> Filtrar por Tipo...</option>
        {% for tipo in tipos_acao %}
        <option value="{{tipo.id}}" {% if tipo_acao_selecionado==tipo.id %}selected{% endif %}>{{tipo.nome}}</option>
        {% endfor %}
    </select>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const instrumentoSelect = document.getElementById("instrumento");
        const obrigacaoSelect = document.getElementById("obrigacao");
        instrumentoSelect.addEventListener("change", async function () {
            const instrumentoId = this.value;
            obrigacaoSelect.innerHTML = '<option value="">Carregando...</option>';
            if (!instrumentoId) {
                obrigacaoSelect.innerHTML = '<option value=""> Filtrar por Obrigação...</option>';
                return;
            }
            const response = await fetch(`/acoes/obrigacoes/?instrumento_id=${instrumentoId}`);
            const data = await response.json();
            obrigacaoSelect.innerHTML = '<option value=""> Filtrar por Obrigação...</option>';
            data.obrigacoes.forEach(o => {
                const opt = document.createElement('option');
                opt.value = o.id;
                opt.textContent = o.titulo;
                obrigacaoSelect.appendChild(opt);
            });
        });
    });
</script>
{% endblock %}

{% block table_headers %}
<th>Nome da Ação</th>
<th>Obrigação</th>
<th>Tipo</th>
<th>Responsável</th>
<th>Período</th>
<th>Progresso</th>
<th>Status</th>
{% endblock %}

{% block table_rows %}
{% for acao in object_list %}
<tr>
    <td>
        <div class="fw-semibold toggle-checklist" data-acao="{{acao.id}}" style="cursor:pointer;">{{acao.nome}}
        </div>
        <small class="text-muted"><i class="bi bi-flag me-1"></i>{{acao.get_prioridade_display}}</small>
        <div class="checklist collapse mt-2" id="checklist-{{acao.id}}">
            <div class="card card-body py-2 bg-light border-0 shadow-none">
                <h6 class="small fw-bold mb-2">Checklist de Tarefas:</h6>
                {% if acao.checklist_itens.exists %}
                {% for item in acao.checklist_itens.all %}
                <div class="d-flex align-items-center mb-1">
                    <input type="checkbox" {% if item.concluido %}checked{% endif %} disabled
                        class="form-check-input form-check-input-sm me-2">
                    <small
                        class="{% if item.concluido %}text-decoration-line-through text-muted{% endif %}">{{item.nome}}</small>
                </div>
                {% endfor %}
                {% else %}
                <small class="text-muted">Nenhuma tarefa operativa definida.</small>
                {% endif %}
            </div>
        </div>
    </td>
    <td><small>{{acao.obrigacao.titulo}}</small></td>
    <td><small>{{acao.tipo_acao.nome|default:"-"}}</small></td>
    <td><small>{{acao.responsavel.get_full_name|default:acao.responsavel.username}}</small></td>
    <td><small><i class="bi bi-calendar me-1"></i>{{acao.data_inicio|date:"d/m/Y"}} -
            {{acao.data_fim|date:"d/m/Y"}}</small></td>
    <td>
        <div class="progress mb-1" style="height: 8px; border-radius: 4px; background-color: #e9ecef;">
            <div class="progress-bar" role="progressbar"
                style="width: {{acao.percentual_cumprido}}%; background: linear-gradient(90deg, #0066B3 0%, #004A8F 100%);"
                aria-valuenow="{{acao.percentual_cumprido}}" aria-valuemin="0" aria-valuemax="100">
            </div>
        </div>
        <small class="text-muted fw-medium">{{acao.percentual_cumprido}}%</small>
    </td>
    <td>
        {% if acao.status == 'finalizado' %}
        <span class="badge bg-success">Finalizado</span>
        {% elif acao.status == 'em_andamento' %}
        <span class="badge bg-gold">Em Andamento</span>
        {% elif acao.status == 'atrasado' %}
        <span class="badge bg-danger">Atrasado</span>
        {% else %}
        <span class="badge bg-secondary">{{acao.get_status_display}}</span>
        {% endif %}
    </td>
    <td>
        <div class="btn-group btn-group-sm">
            <a href="{% url 'acao_edit' acao.pk %}" class="btn btn-outline-primary" title="Editar"><i
                    class="bi bi-pencil"></i></a>
            <a href="{% url 'acao_delete' acao.pk %}" class="btn btn-outline-danger" title="Excluir"><i
                    class="bi bi-trash"></i></a>
        </div>
    </td>
</tr>
{% endfor %}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Toggle checklist preview na lista
        document.querySelectorAll('.toggle-checklist').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.getAttribute('data-acao');
                const checklist = document.getElementById(`checklist-${id}`);
                checklist.classList.toggle('show');
            });
        });

        // ===== INTERCEPTAR O BOTÃO "ADICIONAR AÇÃO" DO TEMPLATE BASE =====
        // O botão padrão usa href direto para acao_create. Interceptamos para abrir modal primeiro.
        const addBtn = document.querySelector('a[href*="acao/novo"], a[href*="adicionar"]');

        // Estratégia: encontrar o botão com texto "Adicionar Ação" na header
        const allLinks = document.querySelectorAll('.page-header a.btn-primary, .page-header a.btn.btn-primary');
        allLinks.forEach(link => {
            if (link.href && link.href.includes('acao_create') || link.textContent.includes('Adicionar')) {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    abrirModalTipo();
                });
            }
        });

        // Busca mais ampla pelo botão Adicionar Ação
        document.querySelectorAll('.page-header a').forEach(link => {
            if (link.textContent.trim().includes('Adicionar')) {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    abrirModalTipo();
                });
                // Também armazenar a URL original como fallback
                link.dataset.originalHref = link.href;
            }
        });
    });

    function abrirModalTipo() {
        // Criar ou reusar modal
        let modal = document.getElementById('modalTipoAcao');
        if (!modal) {
            modal = document.createElement('div');
            modal.id = 'modalTipoAcao';
            modal.className = 'modal fade';
            modal.setAttribute('tabindex', '-1');
            modal.innerHTML = `
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg">
                        <div class="modal-header border-0 pb-0">
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div id="modalTipoBody">
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status"></div>
                                <p class="mt-3 text-muted">Carregando tipos de ação...</p>
                            </div>
                        </div>
                    </div>
                </div>`;
            document.body.appendChild(modal);
        }

        // Abrir o modal Bootstrap
        const bsModal = new bootstrap.Modal(modal);
        bsModal.show();

        // Carregar conteúdo via fetch
        fetch('{% url "acao_tipo_selector" %}')
            .then(r => r.text())
            .then(html => {
                // Extrair apenas o conteúdo do body do fragmento retornado
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const body = doc.querySelector('.modal-body') || doc.body;
                document.getElementById('modalTipoBody').innerHTML = body ? body.outerHTML : html;

                // Reinicializar tooltips no novo conteúdo
                document.querySelectorAll('#modalTipoBody [data-bs-toggle="tooltip"]').forEach(el => {
                    new bootstrap.Tooltip(el);
                });
            })
            .catch(err => {
                document.getElementById('modalTipoBody').innerHTML = `
                    <div class="p-4 text-center text-danger">
                        <i class="bi bi-exclamation-triangle fs-3 d-block mb-3"></i>
                        Erro ao carregar tipos de ação. <a href="{% url 'acao_create' %}">Clique aqui</a> para continuar.
                    </div>`;
            });
    }
</script>
{% endblock %}